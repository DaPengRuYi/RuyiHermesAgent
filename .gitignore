# ============================================================================
# 便携 workspace（HERMES_HOME）—— 由 run.ps1 / run.sh 注入
# 规则：跟踪「结构 + 技能 + 长期记忆 + 模板」，排除「密钥 + 凭据 + 会话历史 + 缓存」。
# 锚定到 /workspace/ 顶层，避免误伤源码其他位置。
# ----------------------------------------------------------------------------
# 密钥与凭据（绝不进包）
/workspace/.env
/workspace/.env.local
/workspace/auth.json
/workspace/auth.lock
/workspace/pairing/
# 会话数据库与历史（可重建，且含隐私）
/workspace/*.db
/workspace/*.db-wal
/workspace/*.db-shm
/workspace/sessions/
# 缓存 / 沙箱 / 日志 / 运行时（可重建，体积大）
/workspace/cache/
/workspace/image_cache/
/workspace/audio_cache/
/workspace/sandboxes/
/workspace/logs/
/workspace/bin/
/workspace/cron/
/workspace/hooks/
/workspace/home/
/workspace/checkpoints/
# 运行时缓存 / 网关 / 看板状态（可重建）
/workspace/models_dev_cache.json
/workspace/channel_directory.json
/workspace/kanban.db
/workspace/gateway.lock
/workspace/gateway.pid
/workspace/gateway_state.json
# 运行时杂项快照
/workspace/.skills_prompt_snapshot.json
/workspace/.hermes_history
/workspace/.update_check
/workspace/.tirith-install-failed
/workspace/active_profile
# 技能目录：bundled 技能由运行时从源码根的 skills/ 自动同步进来（可重建、且与源码 skills/ 完全重复），
# 故整目录排除，只保留 .gitkeep 占位。若日后有「自己新建、需随包」的技能，手动 git add -f 即可。
/workspace/skills/*
!/workspace/skills/.gitkeep
